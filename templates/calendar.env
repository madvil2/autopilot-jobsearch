# Calendar settings for the skills. Copy this file to .calendar.env in your workspace and fill it in
# with the answer from /init.
#
# How interviews and deadlines reach the calendar: app (the calendar app on this machine through
# scripts/calendar.mjs) or connector (the claude.ai Google Calendar connector or any calendar MCP).
# app when absent.
CALENDAR_VIA=app
#
# With app: one of the names that
#   node scripts/calendar.mjs calendars
# prints. On macOS that is Calendar.app: for Google Calendar, add the Google account in System
# Settings > Internet Accounts with Calendars on and pick its calendar here (often named after the
# address). macOS asks once whether the terminal (or Claude) may control Calendar; allow it. On
# Windows it is classic Outlook (untested); leave CALENDAR_NAME empty for Outlook's default calendar.
CALENDAR_NAME=
#
# Optional: the calendar app transport instead of the one for this OS (applecal or outlook).
# CALENDAR_TRANSPORT=applecal
