# Mail account the sweep sends email applications from (scripts/mail.mjs). Copy this file to
# .mail.env in your workspace, fill in the two values, then run: chmod 600 .mail.env
# The app password: Google account with 2-step verification on, open
# https://myaccount.google.com/apppasswords, create one named "autopilot-jobsearch" and copy the
# 16 characters without the spaces. It is not your account password, and you can revoke it there.
MAIL_USER=you@gmail.com
MAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME=First Last
# For an account that is not Gmail, set the provider's SMTP host and TLS port:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
