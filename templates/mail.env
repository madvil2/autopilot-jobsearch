# Mail settings for the skills and scripts/mail.mjs. Copy this file to .mail.env in your workspace and
# fill it in with the answers from /init. MAIL_USER is the address mail goes out from and is read from.
MAIL_USER=you@gmail.com
MAIL_FROM_NAME=First Last
#
# How mail is read and answered: connector (the claude.ai Gmail connector or any mail MCP) or app (the
# mail app below, through scripts/mail.mjs list, show and reply). connector when absent.
MAIL_READ=connector
#
# How email applications with the CV attached are sent: applemail (Mail.app on macOS) or outlook
# (classic Outlook on Windows, untested). Reading with app uses the same mail app. On another OS
# nothing sends: the sweep lists email-only postings in its report for you to send.
#   applemail: add the account in System Settings > Internet Accounts, open Mail once, and allow the
#              terminal (or Claude) to control Mail when macOS asks.
#   outlook:   classic Outlook with the account added (the new Outlook has no scripting interface).
MAIL_TRANSPORT=
#
# Optional, with MAIL_READ=app on macOS: seconds Mail gets to fetch new mail before list reads (0 to 60).
# MAIL_CHECK_WAIT=8
